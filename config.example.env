# Copy to ~/.config/ambilight-music.env and fill in. Never commit the real file.

# Websocket that publishes {"type": "albumCover", "value": "<url>"} messages.
HUB_WS_URL=ws://<hub-host>:<port>/audio

# Shared secret for the control API (/on, /off, /status, /intensity). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CONTROL_TOKEN=

# ALSA capture device that carries the music (see `arecord -L`).
AUDIO_DEVICE=default

# Optional, defaults shown.
# HYPERHDR_HOST=127.0.0.1
# HYPERHDR_PORT=19444
# HYPERHDR_PRIORITY=100
# CONTROL_HOST=0.0.0.0
# CONTROL_PORT=8096
# FPS=50
# INTENSITY=1.0
# LOG_LEVEL=INFO
